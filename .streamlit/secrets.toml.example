# Copy to .streamlit/secrets.toml and fill in real values for local dev.
# For Streamlit Cloud, set these in the Cloud Secrets dashboard.

app_password = "REPLACE_WITH_A_STRONG_PASSWORD"

# Gmail SMTP (Milestone 3 — leave as placeholders for now)
gmail_user = "your.email@gmail.com"
gmail_app_password = "xxxx xxxx xxxx xxxx"
email_recipients = ["mom@email.com", "dad@email.com"]

# Telegram bot (Milestone 2)
telegram_bot_token = ""
telegram_chat_id = ""

# Supabase (Milestone 2)
supabase_url = ""
supabase_anon_key = ""

# Claude API (Milestone 3, optional)
anthropic_api_key = ""
